# ─── Database ───
DATABASE_URL=postgresql://user:password@localhost:5432/falapt
DIRECT_URL=postgresql://user:password@localhost:5432/falapt

# ─── Redis ───
REDIS_URL=redis://localhost:6379

# ─── Auth (Clerk) ───
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# ─── AI ───
ANTHROPIC_API_KEY=sk-ant-xxx
OPENAI_API_KEY=sk-xxx

# ─── Speech ───
AZURE_SPEECH_KEY=xxx
AZURE_SPEECH_REGION=westeurope

# ─── Storage (Cloudflare R2) ───
R2_ACCOUNT_ID=xxx
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET_NAME=fala-pt-audio

# ─── Push (FCM) ───
FCM_PROJECT_ID=xxx
FCM_CLIENT_EMAIL=xxx
FCM_PRIVATE_KEY=xxx

# ─── Payments ───
REVENUECAT_API_KEY=xxx
REVENUECAT_WEBHOOK_SECRET=xxx
APPLE_SHARED_SECRET=xxx
GOOGLE_SERVICE_ACCOUNT_KEY=xxx

# ─── Ads ───
ADMOB_APP_ID_IOS=ca-app-pub-xxx
ADMOB_APP_ID_ANDROID=ca-app-pub-xxx

# ─── Monitoring ───
SENTRY_DSN=https://xxx@sentry.io/xxx
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com
