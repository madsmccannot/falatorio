{
  "name": "@falatorio/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./constants": {
      "types": "./src/constants.ts",
      "default": "./dist/constants.js"
    },
    "./fsrs": {
      "types": "./src/fsrs/index.ts",
      "default": "./dist/fsrs/index.js"
    },
    "./scoring": {
      "types": "./src/scoring/index.ts",
      "default": "./dist/scoring/index.js"
    },
    "./lesson": {
      "types": "./src/lesson/index.ts",
      "default": "./dist/lesson/index.js"
    },
    "./gamification": {
      "types": "./src/gamification/index.ts",
      "default": "./dist/gamification/index.js"
    },
    "./economy": {
      "types": "./src/economy/index.ts",
      "default": "./dist/economy/index.js"
    },
    "./entitlements": {
      "types": "./src/entitlements/index.ts",
      "default": "./dist/entitlements/index.js"
    },
    "./ads": {
      "types": "./src/ads/index.ts",
      "default": "./dist/ads/index.js"
    },
    "./l1-profiles": {
      "types": "./src/l1-profiles/index.ts",
      "default": "./dist/l1-profiles/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "eslint src/"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
