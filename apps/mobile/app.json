{
  "expo": {
    "name": "Falatório",
    "slug": "falatorio",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "falatorio",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.falatorio.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Falatório needs your microphone to evaluate pronunciation exercises.",
        "NSUserTrackingUsageDescription": "We use this to show relevant ads. You can opt out anytime."
      }
    },
    "android": {
      "package": "com.falatorio.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#059669"
      },
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#059669"
        }
      ],
      "expo-web-browser",
      "expo-audio"
    ],
    "extra": {
      "eas": {
        "projectId": "86aa60e7-c4f5-4b75-97fa-7fc21c9f010b"
      },
      "router": {
        "origin": false
      }
    },
    "owner": "madsmccannot"
  }
}
