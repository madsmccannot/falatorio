{
  "expo": {
    "name": "Fala PT",
    "slug": "fala-pt",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "falapt",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#059669"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.falapt.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Fala PT needs your microphone to evaluate pronunciation exercises.",
        "NSUserTrackingUsageDescription": "We use this to show relevant ads. You can opt out anytime."
      }
    },
    "android": {
      "package": "com.falapt.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#059669"
      },
      "permissions": ["RECORD_AUDIO"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX",
          "iosAppId": "ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "PLACEHOLDER"
      },
      "router": {
        "origin": false
      }
    }
  }
}
