{
  "name": "falatorio",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0 || >=22.0.0"
  },
  "devDependencies": {
    "turbo": "^2.3.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "~18.3.0"
    }
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "type-check": "turbo type-check",
    "db:generate": "pnpm --filter @falatorio/db db:generate",
    "db:push": "pnpm --filter @falatorio/db db:push",
    "db:migrate": "pnpm --filter @falatorio/db db:migrate",
    "db:studio": "pnpm --filter @falatorio/db db:studio",
    "clean": "turbo clean && rm -rf node_modules"
  }
}
